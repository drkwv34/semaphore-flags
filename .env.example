# Copy to .env for local development. Never commit .env.
# Values here are throwaway local defaults, not secrets.

# --- API process (read by `pnpm dev` on the host) ---------------------------
NODE_ENV=development
LOG_LEVEL=info
HTTP_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://semaphore:semaphore@localhost:5432/semaphore
# Optional. Unset or empty disables the cache; evaluate then reads Postgres directly.
REDIS_URL=
# Bucketing salts are per project (projects.salt), so there is no global PROJECT_SALT.

# --- Docker Compose interpolation --------------------------------------------
POSTGRES_USER=semaphore
POSTGRES_PASSWORD=semaphore
POSTGRES_DB=semaphore
POSTGRES_PORT=5432
API_PORT=8080
REDIS_PORT=6379
# Set to redis://redis:6379 when running `docker compose --profile cache up`.
API_REDIS_URL=
# Evaluate key printed by the seed (not available until the projects/keys work lands).
DEMO_EVALUATE_KEY=
