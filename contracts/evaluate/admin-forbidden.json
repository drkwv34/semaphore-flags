    "salt": "fixture-salt",
    "env": "prod",
    "flags": []
  },
  "request": {
    "method": "POST",
    "url": "/v1/evaluate",
    "body": { "flag_key": "checkout_v2", "env": "prod", "user": { "id": "user-76" } }
