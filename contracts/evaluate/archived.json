{
  "name": "archived flag is false",
  "auth": "evaluate",
  "setup": {
    "salt": "fixture-salt",
    "env": "prod",
    "flags": [
      {
        "key": "checkout_v2",
        "archived": true,
        "default_value": true,
        "enabled": true,
        "percentage": 100,
        "rules": [{ "attribute": "user.plan", "op": "eq", "value": "pro", "serve": true }]
      }
    ]
  },
  "request": {
    "method": "POST",
    "url": "/v1/evaluate",
    "body": {
      "flag_key": "checkout_v2",
      "env": "prod",
      "user": { "id": "user-76", "attrs": { "plan": "pro" } }
    }
  },
  "response": {
    "status": 200,
    "body": {
      "flag_key": "checkout_v2",
      "value": false,
      "reason": "archived",
      "variant": "off"
    }
  }
}
