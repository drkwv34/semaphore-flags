{
  "name": "batch empty flag_keys is 400",
  "auth": "evaluate",
  "setup": {
    "salt": "fixture-salt",
    "env": "prod",
    "flags": []
  },
  "request": {
    "method": "POST",
    "url": "/v1/evaluate-batch",
    "body": { "env": "prod", "user": { "id": "user-76" }, "flag_keys": [] }
  },
  "response": {
    "status": 400,
    "body": {
      "error": {
        "code": "VALIDATION_FAILED",
        "message": "Request validation failed",
        "request_id": "fixture",
        "fields": [{ "path": "/flag_keys", "message": "must NOT have fewer than 1 items" }]
      }
    }
  }
}
