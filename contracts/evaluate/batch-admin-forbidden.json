{
  "name": "admin key is forbidden on evaluate-batch",
  "auth": "admin",
  "setup": {
    "salt": "fixture-salt",
    "env": "prod",
    "flags": []
  },
  "request": {
    "method": "POST",
    "url": "/v1/evaluate-batch",
    "body": {
      "env": "prod",
      "user": { "id": "user-76" },
      "flag_keys": ["checkout_v2"]
    }
  },
  "response": {
    "status": 403,
    "body": {
      "error": {
        "code": "FORBIDDEN",
        "message": "API key type not allowed for this route",
        "request_id": "fixture"
      }
    }
  }
}
