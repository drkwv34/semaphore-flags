{
  "name": "semaphore-flags",
  "version": "0.0.0",
  "private": true,
  "description": "Feature flags and kill switches with targeting rules, percentage rollouts, audit logs, and a fast HTTP evaluate API.",
  "license": "MIT",
  "author": "Christian Agila",
  "type": "module",
  "bin": {
    "semaphore": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js serve",
    "dev": "tsx watch --env-file-if-exists=.env src/cli.ts serve",
    "migrate": "tsx --env-file-if-exists=.env src/cli.ts migrate",
    "seed": "tsx --env-file-if-exists=.env src/cli.ts seed",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project contract",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:lint": "spectral lint contracts/openapi/openapi.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-cli": "^6.17.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
